# SMTP host used by CommunicationEmailModule.forRoot(...)
COMMUNICATION_EMAIL_SMTP_HOST=localhost

# SMTP port exposed by your mail server or local Mailpit/MailHog instance
COMMUNICATION_EMAIL_SMTP_PORT=1025

# Use "true" for implicit TLS SMTP endpoints such as 465
COMMUNICATION_EMAIL_SMTP_SECURE=false

# Optional SMTP auth credentials. Set both or leave both unset.
# COMMUNICATION_EMAIL_SMTP_USER=
# COMMUNICATION_EMAIL_SMTP_PASSWORD=

# Default sender identity used when sendEmail(...) does not provide `from`
COMMUNICATION_EMAIL_DEFAULT_FROM_EMAIL=noreply@example.com
COMMUNICATION_EMAIL_DEFAULT_FROM_NAME=Application Notifications
